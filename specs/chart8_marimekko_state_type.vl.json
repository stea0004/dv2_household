{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The household mix in each state",
    "subtitle": [
      "Column width = the state's share of all households; column height = mix of household types, 2021 Census Data",
      "The three narrow columns on the right are Tas, NT and ACT"
    ],
    "anchor": "start"



    },

    "data":{"url": "data/household_types_state.csv"},
    "transform": [

        {"joinaggregate": [{"op": "sum", "field": "households", "as": "state_total"}], "groupby": ["state"]},
        {"joinaggregate": [{"op": "sum", "field": "households", "as": "aus_total"}]},

        {
            "window": [{"op": "sum", "field":"households", "as": "cum_in_state"}],
            "groupby": ["state"],
            "sort": [{"field": "type_order"}],
            "frame": [null,0]
        },

        {"calculate": "(datum.cum_in_state - datum.households) / datum.state_total * 100", "as": "y0"},
        {"calculate": "datum.cum_in_state / datum.state_total * 100", "as": "y1"},

        {
            "stack": "households",
            "groupby": [],
            "sort":[{"field":"state_code"}, {"field": "type_order"}],
            "as":["s0","s1"]
        },

        {
            "joinaggregate": [{"op": "min", "field": "s0", "as": "x_start"}, 
            {"op":"max", "field": "s1", "as": "x_end"}],

            "groupby": ["state"]
        },


            {"calculate": "datum.x_start / datum.aus_total * 100", "as": "x0"},
            {"calculate": "datum.x_end / datum.aus_total * 100", "as": "x1"},
            {"calculate": "(datum.x0 + datum.x1) / 2", "as": "x_mid"},
            {"calculate": "(datum.y0 + datum.y1) / 2", "as": "y_mid"}
    ],


    "width": 520,
    "height": 320,
    "layer": [
        {

            "mark":{"type": "rect", "stroke": "white", "strokeWidth": 1},
            "encoding":{
                "x": {"field": "x0", "type": "quantitative", "scale": {"domain":[0,100]},
                "axis": null},
                "x2": {"field": "x1"},
                "y":{

                    "field":"y0",
                    "type": "quantitative",
                    "scale":{"domain": [0,100]
                },

                "title": "% of state households",
                "axis": {
                        "domain": false,
                        "ticks": false

                }
                },


                "y2": {"field": "y1"},
                "color": {
                    "field": "household_type",
                    "type": "nominal",
                    "scale": {
                         "domain": ["Couple without children", "Couple with children", "One-parent family", "Other family", "Lone person", "Group household"],
                         "range": ["#1f4e79", "#5b8fc7", "#9cc3e6", "#c9dcec", "#e07b39", "#a389c9"]
                    },

                    "legend":{ "title": null, "orient": "right", "labelLimit":200}
                },
                "tooltip": [
                {"field": "state_name", "type": "nominal", "title": "State"},
                {"field": "household_type", "type": "nominal", "title": "Household type"},
                {"field": "pct_of_state", "type": "quantitative", "title": "% of state's households", "format": ".1f"},
                {"field": "households", "type": "quantitative", "title": "Households", "format": ","}
                ]
                }
            },

            {
                "transform": [{"filter": "datum.type_order == 1 && datum.x1 - datum.x0 > 4 "}],
                "mark": {
                    "type": "text",
                    "dy": -8,
                    "fontSize": 11,
                    "fontWeight": "bold"
                },
                "encoding": {

                    "x": {"field": "x_mid", "type": "quantitative"},
                    "y": {"value": 0},
                    "text":{"field": "state"}
                }
            },

            {
                
                "transform": [{"filter": "datum.household_type == 'Lone person' && datum.x1 - datum.x0 > 6"}],
                "mark": {"type": "text", "fontSize": 10, "color": "white"},
                "encoding": {
                    "x":  {"field": "x_mid", "type": "quantitative"},
                    "y": {"field": "y_mid", "type": "quantitative"},
                    "text": {"field": "pct_of_state", "type": "quantitative", "format": ".0f"}
                }
            }
        
    ],

    "config": {"view": {"stroke": null}}

}