{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Living alone and apartment living go together",
    "subtitle": "Each SA2 coloured by its share of lone-person households and of households in flats or apartments, 2021 Census",
    "anchor": "start"
  },
  "params": [
    {
      "name": "area",
      "value": "Greater Sydney",
      "bind": {
        "input": "select",
        "name": "Show: ",
        "options": [
          "Australia", "Greater Sydney", "Greater Melbourne", "Greater Brisbane", "Greater Adelaide",
          "Greater Perth", "Greater Hobart", "Greater Darwin", "Australian Capital Territory"
        ]
      }
    }
  ],
  "hconcat": [
    {
      "width": 420,
      "height": 420,
      "projection": {"type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0]},
      "data": {
        "url": "data/SA2_2021_AUST_GDA2020.json",
        "format": {"type": "topojson", "feature": "SA2_2021_AUST_GDA2020"}
      },
      "transform": [
        {"filter": "area == 'Australia' || datum.properties.GCC_NAME21 == area"},
        {
          "lookup": "properties.SA2_CODE21",
          "from": {
            "data": {"url": "data/sa2_households.csv", "format": {"parse": {"sa2_code": "string"}}},
            "key": "sa2_code",
            "fields": ["bivar_class", "lone_pct", "apartment_pct"]
          }
        }
      ],
      "layer": [
        {"mark": {"type": "geoshape", "fill": "#e6e6e6", "stroke": "white", "strokeWidth": 0.2}},
        {
          "transform": [{"filter": "isValid(datum.bivar_class)"}],
          "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.2},
          "encoding": {
            "color": {
              "field": "bivar_class",
              "type": "nominal",
              "scale": {
                "domain": ["1-1", "2-1", "3-1", "1-2", "2-2", "3-2", "1-3", "2-3", "3-3"],
                "range": ["#e8eef5", "#9fbbe0", "#4f78c4", "#b6dde6", "#87a9d0", "#4466a8", "#6fc3d3", "#5a92b8", "#2a4a80"]
              },
              "legend": null
            },
            "tooltip": [
              {"field": "properties.SA2_NAME21", "type": "nominal", "title": "Area"},
              {"field": "lone_pct", "type": "quantitative", "title": "% lone-person households", "format": ".1f"},
              {"field": "apartment_pct", "type": "quantitative", "title": "% in flats or apartments", "format": ".1f"}
            ]
          }
        }
      ]
    },
    {
      "title": {"text": "How to read the colours", "fontSize": 12, "anchor": "start"},
      "width": 120,
      "height": 120,
      "data": {
        "values": [
          {"l": 1, "a": 1, "k": "1-1"}, {"l": 2, "a": 1, "k": "2-1"}, {"l": 3, "a": 1, "k": "3-1"},
          {"l": 1, "a": 2, "k": "1-2"}, {"l": 2, "a": 2, "k": "2-2"}, {"l": 3, "a": 2, "k": "3-2"},
          {"l": 1, "a": 3, "k": "1-3"}, {"l": 2, "a": 3, "k": "2-3"}, {"l": 3, "a": 3, "k": "3-3"}
        ]
      },
      "mark": {"type": "rect", "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "x": {
          "field": "l",
          "type": "ordinal",
          "title": "More living alone →",
          "axis": {"labelExpr": "['', 'Low', 'Mid', 'High'][datum.value]", "labelAngle": 0, "ticks": false, "domain": false}
        },
        "y": {
          "field": "a",
          "type": "ordinal",
          "sort": "descending",
          "title": "More apartments →",
          "axis": {"labelExpr": "['', 'Low', 'Mid', 'High'][datum.value]", "ticks": false, "domain": false}
        },
        "color": {
          "field": "k",
          "type": "nominal",
          "scale": {
            "domain": ["1-1", "2-1", "3-1", "1-2", "2-2", "3-2", "1-3", "2-3", "3-3"],
            "range": ["#e8eef5", "#9fbbe0", "#4f78c4", "#b6dde6", "#87a9d0", "#4466a8", "#6fc3d3", "#5a92b8", "#2a4a80"]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}